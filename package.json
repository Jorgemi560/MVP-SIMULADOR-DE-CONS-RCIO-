{
  "name": "simulador-de-consorcio",
  "version": "0.1.0",
  "description": "MVP: simulação personalizada de consórcio (R$ 5,00) com captura e qualificação de leads (PostgreSQL)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "migrar:sqlite": "node --disable-warning=ExperimentalWarning scripts/migrar-sqlite-para-postgres.js",
    "db:verificar": "node --disable-warning=ExperimentalWarning scripts/db.js verificar",
    "db:criar": "node --disable-warning=ExperimentalWarning scripts/db.js criar",
    "db:schema": "node scripts/gerar-schema-sql.js",
    "pix:verificar": "node --disable-warning=ExperimentalWarning scripts/pix-verificar.js",
    "mp:verificar": "node --disable-warning=ExperimentalWarning scripts/mp-verificar.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
