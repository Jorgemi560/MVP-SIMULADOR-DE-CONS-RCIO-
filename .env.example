PORT=3000
NODE_ENV=development

# Senha do painel /admin (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha

# Valor da simulação em centavos (R$ 5,00 = 500 centavos)
PRICE_CENTS=500

# Pagamento: "pix" (Pix estático com a chave abaixo), "mercadopago" (Pix automático via API) ou "mock" (só testes locais)
PAYMENT_PROVIDER=pix
# Conta recebedora do Pix. Para trocar de conta (ex.: conta definitiva da empresa), altere SÓ estas variáveis.
PIX_CHAVE=sua-chave-pix-aqui
PIX_RECEBEDOR=NOME DA EMPRESA RECEBEDORA
PIX_CIDADE=CIDADE
# (Opcional) segredo (16+ caracteres) para um banco/automação confirmar pagamentos em POST /api/webhooks/pix
PIX_WEBHOOK_SECRET=

# WhatsApp do especialista (só dígitos com DDD). Também pode ser definido em /admin → Configurações.
WHATSAPP_ESPECIALISTA=

# Atrás de proxy/CDN (Render): número de proxies confiáveis. O Dockerfile já usa 1.
TRUST_PROXY_HOPS=1
# Caminho do banco SQLite (no Render: disco montado em /data). O Dockerfile já usa /data/simulador.db.
DB_FILE=./data/simulador.db
# Use =1 só se /data for persistente mas o sistema não conseguir detectar (ex.: VPS).
DB_PERSISTENTE=

# Somente com PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
# URL pública do site (HTTPS ativa HSTS; necessária para o webhook do Mercado Pago)
PUBLIC_URL=https://seu-dominio.com.br
