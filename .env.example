PORT=3000
NODE_ENV=development

# Senha do painel /admin (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha

# Valor da simulação em centavos (R$ 5,00 = 500 centavos)
PRICE_CENTS=500
# Validade de cada Pix, em minutos (padrão 30; no Mercado Pago o mínimo é 30). Vencido, o cliente gera um novo Pix.
PIX_VALIDADE_MINUTOS=30
# Após um "já paguei" sem confirmação, em quantos minutos o cliente pode gerar outro Pix (padrão 15).
PIX_CONFERENCIA_MINUTOS=15

# Pagamento: "pix" (Pix estático com a chave abaixo), "mercadopago" (Pix automático via API) ou "mock" (só testes locais)
PAYMENT_PROVIDER=pix
# Conta recebedora do Pix. Para trocar de conta (ex.: conta definitiva da empresa), altere SÓ estas variáveis.
PIX_CHAVE=sua-chave-pix-aqui
PIX_RECEBEDOR=NOME DA EMPRESA RECEBEDORA
PIX_CIDADE=CIDADE
# (Opcional) segredo (16+ caracteres) para um banco/automação confirmar pagamentos em POST /api/webhooks/pix
PIX_WEBHOOK_SECRET=

# WhatsApp do especialista (só dígitos com DDD). Também pode ser definido em /admin → Configurações.
WHATSAPP_ESPECIALISTA=

# Atrás de proxy/CDN (Render): número de proxies confiáveis. O Dockerfile já usa 1.
TRUST_PROXY_HOPS=1
# Banco de dados PostgreSQL EXTERNO (obrigatório em produção). Exemplo: postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=
# Para conferir a conexão sem subir o site: DATABASE_URL=... npm run db:verificar
# (Opcional) off = sem SSL | on = SSL verificado (padrão em bancos públicos) | insecure = SSL sem verificar o certificado
DATABASE_SSL=
# (Opcional) conexões simultâneas ao banco (padrão 5)
DB_POOL_MAX=
# Só desenvolvimento local, sem DATABASE_URL: pasta para guardar o banco de teste (vazio = em memória)
PGLITE_DIR=

# Somente com PAYMENT_PROVIDER=mercadopago (token de PRODUÇÃO APP_USR-…, URL pública https e, opcional, a assinatura secreta do webhook)
# MP_WEBHOOK_SECRET=
# MP_VARREDURA_SEGUNDOS=30
MP_ACCESS_TOKEN=
# URL pública do site (HTTPS ativa HSTS; necessária para o webhook do Mercado Pago)
PUBLIC_URL=https://seu-dominio.com.br
