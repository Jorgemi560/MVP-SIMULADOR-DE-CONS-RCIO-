PORT=3000
NODE_ENV=development

# Senha do painel /admin (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha

# Valor da simulação em centavos (R$5,00 = 500)
PRICE_CENTS=500

# Pagamento: "pix" (Pix estático com a chave abaixo), "mercadopago" (Pix automático via API) ou "mock" (só testes)
PAYMENT_PROVIDER=pix
PIX_CHAVE=49753831000123
PIX_RECEBEDOR=LATRYKA INDUSTRIAL E COMERCIOS LTDA
PIX_CNPJ=49.753.831/0001-23
# Cidade do recebedor exibida no Pix (confirme a correta)
PIX_CIDADE=CURITIBA
# "informado": libera ao tocar em "Já fiz o pagamento" (você confere no /admin) | "confirmado": só após você confirmar no /admin
PIX_LIBERAR=informado

# Somente com PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
# URL pública do site (necessária para o webhook do Mercado Pago)
PUBLIC_URL=https://seu-dominio.com.br
